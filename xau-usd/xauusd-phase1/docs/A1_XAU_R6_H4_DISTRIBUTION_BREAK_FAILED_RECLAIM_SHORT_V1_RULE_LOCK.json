    "portfolio_data",
    "balance_or_equity",
    "mfe_or_mae",
    "win_loss_or_sltp_labels",
    "future_market_data_after_entry_tick",
    "known_loss_period_identifiers"
  ],
  "impulse": {
    "bars": 6,
    "bullish_bars_min": 4,
    "final_location_min": 0.75,
    "h4_shifts": [13, 12, 11, 10, 9, 8],
    "min_net_advance_atr": 1.5,
    "min_range_atr": 2.0
  },
  "incidence_gates": {
    "deployment_risk": {
      "early_half_min": 35,
