  "stop": {
    "base": "max(reclaim_bar_high,box_low)+0.25*A_reclaim",
    "buffer_atr": 0.25,
    "normalize": "upward_to_next_symbol_tick",
    "target_forbidden_in_census": true
  },
  "suppression": {
    "box_id": "sha256(rule_version|symbol|six_distribution_h4_open_times|tick_normalized_box_low|tick_normalized_box_high)",
    "max_additional_completed_h4_bars": 12,
    "one_breakdown_per_box": true,
    "one_signal_per_episode": true,
    "release_on_completed_h4_close_at_or_above_original_box_mid": true,
    "result_or_position_state_forbidden": true,
    "scope": "symbol_and_direction"
  }
