    "attempt_close_must_be_below_open": true,
    "attempt_touch_below_level_atr": 0.1,
    "first_attempt_only": true,
    "frozen_level": "box_low",
    "h1_completed_bars_max": 6,
    "no_attempt_status": "NO_RECLAIM_WITHIN_SIX_H1",
    "nonrejection_status": "FIRST_RECLAIM_NOT_REJECTED"
  },
  "router": {
    "allowed_states": ["UPTREND", "CHOP"],
    "blocked_states": ["SHOCK", "COMPRESSION", "DOWNTREND", "UNKNOWN"],
    "market_only_completed_data": true,
    "version": "ROUTER_V1"
  },
  "rule_version": "R6_H4_DISTRIBUTION_BREAK_FAILED_RECLAIM_SHORT_V1",
  "schema_version": "a1_xau_r6_rule_lock_v1",
  "status_precedence": [
    "R6_CENSUS_EVIDENCE_INVALID",
    "R6_CENSUS_INSUFFICIENT_INCIDENCE",
