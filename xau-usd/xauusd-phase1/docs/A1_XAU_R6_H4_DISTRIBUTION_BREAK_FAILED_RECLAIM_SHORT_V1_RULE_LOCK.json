{
  "account_reference": {
    "compounding": false,
    "deployment_equity_usd": 1000.0,
    "deployment_max_initial_risk_usd": 2.5,
    "reference_equity_usd": 10000.0,
    "reference_max_initial_risk_usd": 25.0
  },
  "atr": {
    "insufficient_or_nonpositive": "DATA_UNAVAILABLE",
    "method": "wilder_rma",
    "period": 14,
    "references": {
      "a_box": "h4_shift_2",
      "a_break": "h4_shift_2",
      "a_impulse": "h4_shift_8",
      "a_reclaim": "h1_first_completed_reclaim_attempt"
    },
    "seed": "arithmetic_mean_first_14_valid_true_ranges",
    "true_range": "max(high-low,abs(high-previous_close),abs(low-previous_close))",
    "update": "(13*previous_atr+true_range)/14"
  },
  "box": {
    "adjacent_overlap_min_ratio": 0.25,
    "adjacent_overlap_pairs_min": 4,
    "bars": 6,
    "h4_shifts": [7, 6, 5, 4, 3, 2],
    "inner_band_high_fraction": 0.8,
    "inner_band_low_fraction": 0.2,
    "inner_closes_min": 4,
    "max_abs_net_drift_atr": 0.75,
    "max_width_atr": 3.0,
    "min_width_atr": 1.0
  },
  "breakdown": {
    "body_fraction_min": 0.5,
    "close_location_max": 0.25,
    "close_must_be_below_open": true,
    "close_shift_2_must_be_at_or_above_box_low": true,
    "h4_shift": 1,
    "min_close_below_box_low_atr": 0.1,
    "only_immediate_bar_after_box": true
  },
  "contract_risk": {
    "calculation": "abs(OrderCalcProfit(ORDER_TYPE_SELL,symbol,SYMBOL_VOLUME_MIN,entry_bid,normalized_structural_stop_plus_one_tick))",
    "invalid_metadata_action": "fail_closed",
    "required_snapshot_fields": [
      "account_currency",
      "account_leverage",
      "margin_mode",
      "server",
      "symbol",
      "volume_min",
      "volume_step",
      "volume_max",
      "contract_size",
      "tick_size",
      "tick_value",
      "tick_value_loss",
      "stops_level",
      "freeze_level"
    ]
  },
  "data_boundary": {
    "from_date": "2016-07-01",
    "h4_shift_zero_forbidden": true,
    "missing_bar_policy": "DATA_UNAVAILABLE_NO_FORWARD_FILL",
    "native_broker_bars_only": true,
    "to_date": "2026-06-30"
  },
  "entry_tick": {
    "entry_ask_usage": "spread_evidence_only",
    "entry_reference": "bid",
    "expiry_minutes_after_scheduled_h1_close": 15,
    "must_be_first_recorded_tick_of_next_h1_bar": true,
    "must_be_session_open": true,
    "must_be_strictly_after_reclaim_bar_sequence": true,
    "unavailable_status": "ENTRY_TICK_UNAVAILABLE"
