      "july_june_buckets_with_events_min": 8,
      "late_half_min": 35,
      "opportunities_min": 100
    },
    "halves": {
      "early": ["2016-07-01", "2021-06-30"],
      "late": ["2021-07-01", "2026-06-30"]
    },
    "raw": {
      "best_contiguous_24_month_share_max": 0.4,
      "early_half_min": 40,
      "july_june_buckets_min": 8,
      "late_half_min": 40,
      "opportunities_min": 120,
      "opportunities_per_qualifying_bucket_min": 5,
      "single_july_june_bucket_share_max": 0.25
    },
    "reference_risk": {
      "early_half_min": 35,
      "july_june_buckets_with_events_min": 8,
      "late_half_min": 35,
      "opportunities_min": 100
    }
  },
  "outcome_blind": {
    "prefix_invariance_required": true,
