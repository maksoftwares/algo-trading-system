  "strategy": {
    "family_id": "dukascopy_d1_compression_h4_breakout_v1",
    "minimum_active_h1_bars_per_d1": 12,
    "minimum_active_h1_bars_per_h4": 2,
    "d1_atr_period": 14,
    "d1_atr_percentile_lookback": 252,
    "d1_atr_percentile_maximum": 80.0,
    "d1_box_days": 2,
