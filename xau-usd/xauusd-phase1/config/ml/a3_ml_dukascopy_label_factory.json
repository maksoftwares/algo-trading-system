{
  "schema_version": "a3_ml_dukascopy_label_factory_v1",
  "storage_environment_variable": "DUKASCOPY_TICK_DATA_ROOT",
  "default_storage_root": "C:/DukascopyTickDataFoundationV1",
  "external_output_subdirectory": "research/xau-label-factory-v1",
  "symbol": "XAUUSD",
  "period": {
    "start_month": "2018-07",
    "end_month": "2024-06"
  },
  "splits": {
    "train_end_exclusive_utc": "2021-07-01T00:00:00Z",
    "validation_end_exclusive_utc": "2023-07-01T00:00:00Z",
    "test_end_exclusive_utc": "2024-07-01T00:00:00Z"
  },
  "candidate_family": {
    "family_id": "dukascopy_h1_symmetric_ema_pullback_v1",
    "fast_ema_period": 20,
    "slow_ema_period": 50,
    "slope_lag_bars": 5,
    "atr_period": 14,
    "touch_lookback_bars": 3,
    "touch_zone_atr": 0.25,
    "stop_buffer_atr": 0.25,
    "minimum_body_fraction": 0.35,
    "long_close_location_minimum": 0.65,
    "short_close_location_maximum": 0.35,
    "minimum_stop_price": 3.5,
    "maximum_stop_price": 22.0,
    "reward_r": 2.0
  },
  "execution": {
    "lot_size": 0.01,
    "contract_size_ounces_per_lot": 100.0,
    "maximum_entry_delay_minutes": 5,
    "maximum_hold_hours": 120,
    "maximum_timeout_exit_grace_hours": 72,
    "extra_execution_cost_usd": 0.3,
    "holding_cost_per_24h_usd": 0.35
  },
  "quality_gates": {
    "expected_months": 72,
    "minimum_total_candidates": 1000,
    "minimum_resolved_share": 0.99,
    "minimum_rows_per_split": 150,
    "minimum_rows_per_direction": 200,
    "minimum_minority_label_share": 0.2
  },
  "strategy_research_gates": {
    "minimum_train_stress_profit_factor": 1.2,
    "minimum_validation_stress_profit_factor": 1.2,
    "minimum_test_stress_profit_factor": 1.1,
    "minimum_validation_average_stress_r": 0.05,
    "minimum_test_average_stress_r": 0.0,
    "maximum_test_closed_drawdown_r": 20.0
  },
  "outputs": {
    "candidates_csv": "outputs/reports/A3_ML_DUKASCOPY_LABEL_FACTORY_CANDIDATES.csv",
    "labels_csv": "outputs/reports/A3_ML_DUKASCOPY_LABEL_FACTORY_LABELS.csv",
    "report_json": "outputs/reports/A3_ML_DUKASCOPY_LABEL_FACTORY_REPORT.json",
    "report_markdown": "outputs/reports/A3_ML_DUKASCOPY_LABEL_FACTORY_REPORT.md"
  },
  "authorization": {
    "research_only": true,
    "model_training_authorized_if_quality_gates_pass": true,
    "python_demo_predictions_authorized": false,
    "ea_consumption_authorized": false,
    "broker_action_authorized": false
  }
}
