{
  "schema_version": "a3_ml_dukascopy_microstructure_regime_v1",
  "storage_environment_variable": "DUKASCOPY_TICK_DATA_ROOT",
  "cache_sets": [
    {
      "cache_id": "development_2018_2021",
      "relative_root": "research/xau-crossasset-residual-continuation-v1/stage-a/run-one",
      "start_month": "2018-07",
      "end_month": "2021-06"
    },
    {
      "cache_id": "later_2021_2024",
      "relative_root": "research/xau-crossasset-residual-v1/review-corrections/corrected-run-one",
      "start_month": "2021-07",
      "end_month": "2024-06"
    }
  ],
  "instruments": ["XAUUSD", "XAGUSD", "EURUSD", "USDJPY"],
  "windows": {
    "train_start_utc": "2018-07-01T00:00:00Z",
    "train_end_exclusive_utc": "2020-07-01T00:00:00Z",
    "validation_end_exclusive_utc": "2021-07-01T00:00:00Z",
    "internal_test_end_exclusive_utc": "2022-07-01T00:00:00Z",
    "exam_end_exclusive_utc": "2024-07-01T00:00:00Z"
  },
  "aggregation": {
    "timeframe_minutes": 5,
    "minimum_tick_count": 10,
    "external_feature_cache": "research/xau-microstructure-regime-v1/features/m5_features_v1.parquet",
    "external_feature_manifest": "research/xau-microstructure-regime-v1/features/m5_features_v1.manifest.json"
  },
  "regimes": {
    "ema_fast_bars": 12,
    "ema_slow_bars": 48,
    "atr_bars": 14,
    "trend_gap_atr": 0.35,
    "range_gap_atr": 0.20,
    "range_max_atr_ratio": 1.0,
    "shock_return_15m_atr": 1.0
  },
  "specialists": {
    "families": [
      "TREND_PULLBACK",
      "TREND_BREAKOUT",
      "RANGE_FADE",
      "SHOCK_CONTINUATION",
      "SHOCK_REVERSAL"
    ],
    "breakout_lookback_bars": 12,
    "range_zscore_threshold": 1.5,
    "family_cooldown_minutes": 15,
    "shock_cooldown_minutes": 30,
    "train_family_gate": {
      "minimum_trades": 100,
      "minimum_baseline_profit_factor": 0.85,
      "minimum_stress_profit_factor": 0.75,
      "minimum_average_stress_r": -0.12
    }
  },
  "execution": {
    "risk_atr_multiple": 1.0,
    "reward_r": 1.5,
    "maximum_holding_bars": 12,
    "maximum_entry_spread_r": 0.25,
    "stress_slippage_r": 0.10,
    "same_bar_collision_policy": "STOP_FIRST"
  },
  "features": [
    "direction_sign",
    "xau_return_5m_directional_r",
    "xau_return_15m_directional_r",
    "xau_return_60m_directional_r",
    "ema_gap_directional_r",
    "ema_distance_directional_r",
    "tick_imbalance_5m_directional",
    "tick_imbalance_15m_directional",
    "tick_imbalance_60m_directional",
    "book_imbalance_5m_directional",
    "book_imbalance_15m_directional",
    "microprice_edge_5m_directional",
    "microprice_edge_15m_directional",
    "xag_return_5m_directional",
    "xag_return_15m_directional",
    "xag_return_60m_directional",
    "eurusd_return_15m_directional",
    "eurusd_return_60m_directional",
    "usdjpy_return_15m_directional",
    "usdjpy_return_60m_directional",
    "atr_fraction_of_price",
    "atr_ratio_1d",
    "quote_intensity_ratio",
    "realized_volatility_ratio",
    "entry_spread_r",
    "spread_shock_ratio",
    "price_efficiency_5m",
    "hour_sin",
    "hour_cos",
    "weekday_sin",
    "weekday_cos",
    "family_trend_pullback",
    "family_trend_breakout",
    "family_range_fade",
    "family_shock_continuation",
    "family_shock_reversal",
    "regime_trend",
    "regime_range",
    "regime_shock"
  ],
  "model": {
    "family": "HIST_GRADIENT_BOOSTING_REGRESSOR_V1",
    "loss": "squared_error",
    "learning_rate": 0.05,
    "max_iter": 250,
    "max_leaf_nodes": 15,
    "max_depth": 4,
    "min_samples_leaf": 100,
    "l2_regularization": 2.0,
    "early_stopping": false,
    "random_state": 20260716
  },
  "selection": {
    "train_score_top_fractions": [0.30, 0.20, 0.10],
    "maximum_concurrent_trades": 1,
    "maximum_trades_per_utc_day": 4,
    "portfolio_cooldown_minutes": 15
  },
  "validation_gates": {
    "minimum_auc": 0.52,
    "minimum_spearman": 0.03,
    "minimum_trades": 100,
    "minimum_trades_per_source_day": 0.50,
    "maximum_trades_per_source_day": 3.0,
    "minimum_stress_profit_factor": 1.10,
    "minimum_average_stress_r": 0.02,
    "minimum_positive_month_share": 0.50,
    "maximum_closed_drawdown_r": 25.0,
    "require_top10_winners_removed_net_positive": true
  },
  "test_gates": {
    "minimum_auc": 0.52,
    "minimum_spearman": 0.03,
    "minimum_trades": 100,
    "minimum_trades_per_source_day": 0.50,
    "maximum_trades_per_source_day": 3.0,
    "minimum_stress_profit_factor": 1.10,
    "minimum_average_stress_r": 0.03,
    "minimum_positive_month_share": 0.50,
    "maximum_closed_drawdown_r": 25.0,
    "require_top10_winners_removed_net_positive": true
  },
  "exam_gates": {
    "minimum_trades": 200,
    "minimum_trades_per_source_day": 0.50,
    "maximum_trades_per_source_day": 3.0,
    "minimum_stress_profit_factor": 1.15,
    "minimum_average_stress_r": 0.04,
    "minimum_positive_month_share": 0.55,
    "maximum_closed_drawdown_r": 35.0,
    "require_top10_winners_removed_net_positive": true
  },
  "outputs": {
    "model_joblib": "outputs/reports/A3_ML_DUKASCOPY_MICROSTRUCTURE_REGIME_V1_MODEL.joblib",
    "family_metrics_csv": "outputs/reports/A3_ML_DUKASCOPY_MICROSTRUCTURE_REGIME_V1_FAMILY_METRICS.csv",
    "evaluations_csv": "outputs/reports/A3_ML_DUKASCOPY_MICROSTRUCTURE_REGIME_V1_EVALUATIONS.csv",
    "predictions_csv": "outputs/reports/A3_ML_DUKASCOPY_MICROSTRUCTURE_REGIME_V1_PREDICTIONS.csv",
    "report_json": "outputs/reports/A3_ML_DUKASCOPY_MICROSTRUCTURE_REGIME_V1_REPORT.json",
    "report_markdown": "outputs/reports/A3_ML_DUKASCOPY_MICROSTRUCTURE_REGIME_V1_REPORT.md"
  },
  "authorization": {
    "research_only": true,
    "validation_outcomes_authorized": true,
    "internal_test_requires_validation_pass": true,
    "exam_requires_internal_test_pass": true,
    "python_demo_predictions_authorized": false,
    "ea_consumption_authorized": false,
    "broker_action_authorized": false
  }
}
