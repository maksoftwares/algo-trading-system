{
  "contract_id": "futures-trade-feature-contract-v1",
  "schema": "trades",
  "tick_size": 0.1,
  "feature_windows_seconds": [5, 30, 60, 300],
  "instrument_warmup_seconds": 300,
  "session": {
    "timezone": "America/New_York",
    "start": "08:20",
    "end": "13:30"
  },
  "candidate_rules": {
    "flow_continuation": {
      "minimum_contract_volume_5s": 20.0,
      "minimum_absolute_flow_imbalance_5s": 0.55,
      "minimum_absolute_flow_imbalance_30s": 0.25,
      "minimum_volume_share_5s_of_60s": 0.25,
      "minimum_directional_impulse_ticks_5s": 2.0,
      "cooldown_seconds": 60
    },
    "absorption_reversal": {
      "minimum_contract_volume_5s": 20.0,
      "minimum_absolute_flow_imbalance_5s": 0.65,
      "minimum_volume_share_5s_of_60s": 0.25,
      "maximum_absolute_impulse_ticks_5s": 1.0,
      "cooldown_seconds": 120
    }
  },
  "research_controls": {
    "zero_payment_lane": true,
    "features_use_completed_windows_only": true,
    "cross_instrument_roll_features_prohibited": true,
    "unavailable_bbo_fields_must_not_be_imputed": true,
    "random_split_prohibited": true,
    "research_only": true,
    "broker_action_authorized": false
  }
}
