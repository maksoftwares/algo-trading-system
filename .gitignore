.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Phase 2X owner authorization and execution-enabled presets are local/private.
xau-usd/xauusd-phase1/local/
xau-usd/xauusd-wr50-experimental/local/
*.owner_authorized_demo_xauusd.local.set
*owner_authorized*.local.*
PHASE2X_OWNER_APPROVAL.local.*

# Market data and generated research outputs should be controlled by package-level ignores.
outputs/
data/processed/
data/raw/

